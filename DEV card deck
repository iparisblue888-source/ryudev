    function renderDeckStack() {
      cardStackContainer.innerHTML = '';
      cardDeck.forEach((card, idx) => {
        const cardElem = createCardElement(card, idx, cardDeck.length);
        updateCardTransform(cardElem, idx, activeCardIndex);
        cardStackContainer.appendChild(cardElem);

        cardElem.addEventListener('click', (e) => {
          if (idx === activeCardIndex) {
            flipCard(cardElem, idx);
          }
        });

        setupCardTilt(cardElem);
      });

      updateProgressUI();
    }

    function updateCardTransform(cardElem, index, activeIdx) {
      const offset = index - activeIdx;
      
      if (offset < 0) {
        cardElem.style.transform = `translate3d(-400px, 0px, -100px) rotate(-25deg)`;
        cardElem.style.opacity = '0';
        cardElem.style.pointerEvents = 'none';
      } else if (offset === 0) {
        cardElem.style.transform = `translate3d(0px, 0px, 0px) rotate(0deg) scale(1)`;
        cardElem.style.opacity = '1';
        cardElem.style.zIndex = '30';
        cardElem.style.pointerEvents = 'auto';
      } else {
        const depthY = offset * 6;
        const depthZ = -offset * 30;
        const scale = 1 - offset * 0.04;
        cardElem.style.transform = `translate3d(0px, ${depthY}px, ${depthZ}px) scale(${scale})`;
        cardElem.style.opacity = '1';
        cardElem.style.zIndex = `${30 - offset}`;
        cardElem.style.pointerEvents = 'none';
      }
    }

    function flipCard(cardElem, index) {
      const inner = cardElem.querySelector('.card-inner');
      if (inner && !isFlippedArray[index]) {
        isFlippedArray[index] = true;
        inner.style.transform = 'rotateY(180deg)';
        soundFx.playFlip();

        soundFx.playSparkle();
        const rect = cardElem.getBoundingClientRect();
        spawnBurst(rect.left + rect.width / 2, rect.top + rect.height / 2, 40);
      }
    }

    function setupCardTilt(cardElem) {
      cardElem.addEventListener('mousemove', (e) => {
        const rect = cardElem.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        
        const rotateX = ((y - centerY) / centerY) * -12;
        const rotateY = ((x - centerX) / centerX) * 12;

        const inner = cardElem.querySelector('.card-inner');
        if (!inner) return;

        if (parseInt(cardElem.dataset.index) === activeCardIndex) {
          const isFlipped = isFlippedArray[activeCardIndex];
          const flipDeg = isFlipped ? 180 : 0;
          inner.style.transform = `rotateY(${flipDeg + rotateY}deg) rotateX(${rotateX}deg)`;
        }

        cardElem.style.setProperty('--mouse-x', `${(x / rect.width) * 100}%`);
        cardElem.style.setProperty('--mouse-y', `${(y / rect.height) * 100}%`);
      });

      cardElem.addEventListener('mouseleave', () => {
        const inner = cardElem.querySelector('.card-inner');
        if (!inner) return;
        const isFlipped = isFlippedArray[parseInt(cardElem.dataset.index)];
        inner.style.transform = isFlipped ? 'rotateY(180deg)' : 'rotateY(0deg)';
      });
    }

    function shufflePack() {
      soundFx.playShuffle();
      const allCards = cardStackContainer.querySelectorAll('.card-container');

      allCards.forEach((card, idx) => {
        if (idx % 2 === 0) {
          card.classList.add('shuffle-fan-left');
        } else {
          card.classList.add('shuffle-fan-right');
        }
