    let particles = [];

    function resizeCanvas() {
      if (!canvas) return;
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    class Particle {
      constructor(x, y, color, speedScale = 1) {
        this.x = x || Math.random() * (canvas ? canvas.width : 800);
        this.y = y || Math.random() * (canvas ? canvas.height : 600);
        this.size = Math.random() * 3 + 1;
        this.speedX = (Math.random() - 0.5) * 1.5 * speedScale;
        this.speedY = (Math.random() - 0.5) * 1.5 * speedScale - 0.5;
        this.color = color || ['#ff77e9', '#38bdf8', '#ffd700', '#c084fc'][Math.floor(Math.random() * 4)];
        this.alpha = Math.random() * 0.8 + 0.2;
        this.life = Math.random() * 100 + 100;
      }

      update() {
        this.x += this.speedX;
        this.y += this.speedY;
        this.alpha -= 0.005;
        this.life--;
      }

      draw(context) {
        if (!context) return;
        context.save();
        context.globalAlpha = Math.max(0, this.alpha);
        context.fillStyle = this.color;
        context.shadowBlur = 10;
        context.shadowColor = this.color;
        context.beginPath();
        context.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        context.fill();
        context.restore();
      }
    }

    function spawnBurst(x, y, count = 25) {
      if (!canvas) return;
      for (let i = 0; i < count; i++) {
        particles.push(new Particle(x, y, '#ffd700', 3));
        particles.push(new Particle(x, y, '#ff77e9', 3));
      }
    }

    function initParticles() {
      particles = [];
      if (!canvas) return;
      for (let i = 0; i < 40; i++) {
        particles.push(new Particle());
      }
    }
    initParticles();

    function renderParticles() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (let i = particles.length - 1; i >= 0; i--) {
        particles[i].update();
        particles[i].draw(ctx);
        if (particles[i].alpha <= 0 || particles[i].life <= 0) {
          particles.splice(i, 1);
          particles.push(new Particle());
        }
      }
      requestAnimationFrame(renderParticles);
    }
    renderParticles();

