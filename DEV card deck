        /* ==========================================================================
           5. PACK GENERATOR LOGIC
           ========================================================================== */
        function generatePack() {
            // Pack of 5 cards:
            // Card 1-3: Common (60% weight) or Uncommon
            // Card 4: Guaranteed Uncommon or higher
            // Card 5: Rare Holo (10%) or Ultra Rare VSTAR (5%) or Common/Uncommon
            const pack = [];

            const getWeightedCard = (minTier = 0) => {
                const rand = Math.random() * 100;
                let targetRarity = 0; // Common

                if (minTier >= 3 || (minTier === 0 && rand < 5)) {
                    // VSTAR
                    targetRarity = 3;
                } else if (minTier >= 2 || (minTier === 0 && rand < 15)) {
                    // Rare Holo
                    targetRarity = 2;
                } else if (minTier >= 1 || (minTier === 0 && rand < 40)) {
                    // Uncommon
                    targetRarity = 1;
                } else {
                    targetRarity = 0;
                }

                // Filter pool by targetRarity
                let pool = CARD_SET.filter(c => c.rarityTier === targetRarity);
                if (pool.length === 0) pool = CARD_SET; // Fallback

                return pool[Math.floor(Math.random() * pool.length)];
            };

            // Slot 1, 2, 3: Commons / Uncommons
            pack.push(getWeightedCard(0));
            pack.push(getWeightedCard(0));
            pack.push(getWeightedCard(0));
            
            // Slot 4: Guaranteed Uncommon or higher
            pack.push(getWeightedCard(1));

            // Slot 5: High chance Rare / VSTAR Chase Slot!
            const hitRoll = Math.random() * 100;
            if (hitRoll < 20) {
                // Guaranteed VSTAR (20% of slot 5 -> overall 5% pack rate)
                const vstarPool = CARD_SET.filter(c => c.rarityTier === 3);
                pack.push(vstarPool[Math.floor(Math.random() * vstarPool.length)]);
            } else if (hitRoll < 55) {
                // Guaranteed Rare Holo
                const rarePool = CARD_SET.filter(c => c.rarityTier === 2);
                pack.push(rarePool[Math.floor(Math.random() * rarePool.length)]);
            } else {
                pack.push(getWeightedCard(1));
            }

            return pack;
        }


