    function handleTearMove(clientX) {
      if (isPackRipped) return;
      const handleRect = tearHandle.getBoundingClientRect();
      const deltaX = Math.max(0, clientX - tearStartX);
      const progress = Math.min(1, deltaX / (handleRect.width * 0.8));

      tearProgressBar.style.width = `${progress * 100}%`;
      packTop.style.transform = `rotate(${progress * 12}deg) translateY(${progress * 6}px)`;

      if (Math.random() < 0.3) {
        soundFx.playTear();
