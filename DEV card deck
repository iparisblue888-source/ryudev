        /* ==========================================================================
           8. 3D HOLOGRAM TILT SYSTEM
           ========================================================================== */
        function attachHoloTiltListeners(cardEl) {
            cardEl.addEventListener('mousemove', (e) => {
                if (!cardEl.classList.contains('is-flipped')) return;

                const rect = cardEl.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                const rotateX = ((y - centerY) / centerY) * -18;
                const rotateY = ((x - centerX) / centerX) * 18 + 180; // +180 for flipped state

                const glareX = (x / rect.width) * 100;
                const glareY = (y / rect.height) * 100;
                const angle = Math.atan2(y - centerY, x - centerX) * (180 / Math.PI);

                cardEl.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.04)`;

                const holoOverlay = cardEl.querySelector('.holo-overlay');
                const glareOverlay = cardEl.querySelector('.glare-overlay');

                if (holoOverlay) {
                    holoOverlay.style.setProperty('--holo-angle', `${angle}deg`);
                    holoOverlay.style.setProperty('--holo-opacity', '0.7');
                }
                if (glareOverlay) {
                    glareOverlay.style.setProperty('--glare-x', `${glareX}%`);
                    glareOverlay.style.setProperty('--glare-y', `${glareY}%`);
                    glareOverlay.style.setProperty('--holo-opacity', '0.6');
                }
            });

            cardEl.addEventListener('mouseleave', () => {
                if (cardEl.classList.contains('is-flipped')) {
                    cardEl.style.transform = 'rotateY(180deg)';
                } else {
                    cardEl.style.transform = 'none';
                }

                const holoOverlay = cardEl.querySelector('.holo-overlay');
                const glareOverlay = cardEl.querySelector('.glare-overlay');
                if (holoOverlay) holoOverlay.style.setProperty('--holo-opacity', '0');
                if (glareOverlay) glareOverlay.style.setProperty('--holo-opacity', '0');
            });
        }


        /* ==========================================================================
           9. COLLECTION BINDER & INSPECTOR MODAL
           ========================================================================== */
        const binderModal = document.getElementById('binder-modal');
        const binderGrid = document.getElementById('binder-grid');
        const btnOpenBinder = document.getElementById('btn-open-binder');
        const btnCloseBinder = document.getElementById('btn-close-binder');

        const inspectorModal = document.getElementById('inspector-modal');
        const inspectorCardTarget = document.getElementById('inspector-card-target');
        const btnCloseInspector = document.getElementById('btn-close-inspector');

        function renderBinder() {
            binderGrid.innerHTML = '';

            CARD_SET.forEach(card => {
                const qty = state.collection[card.id] || 0;
                const isUnlocked = qty > 0;

                const slotEl = document.createElement('div');
                slotEl.className = `relative rounded-xl border p-2 flex flex-col items-center justify-between cursor-pointer transition transform hover:scale-105 ${isUnlocked ? 'bg-slate-900 border-slate-700 hover:border-pink-500' : 'bg-slate-950/80 border-slate-850 opacity-50 grayscale'}`;

                slotEl.innerHTML = `
                    <div class="w-full h-44 rounded-lg overflow-hidden relative flex items-center justify-center bg-slate-950">
                        ${isUnlocked 
                            ? `<img src="${card.image || 'https://placehold.co/300x400/1e293b/ffffff?text='+encodeURIComponent(card.name)}" class="w-full h-full object-cover rounded-lg">`
                            : `<div class="text-center p-2"><i class="fa-solid fa-lock text-3xl text-slate-600 mb-2"></i><div class="text-[10px] font-bold text-slate-500">???</div></div>`
                        }
                    </div>
                    <div class="w-full mt-2 text-center">
                        <div class="text-xs font-black truncate text-white">${isUnlocked ? card.name : 'Locked Card'}</div>
                        <div class="flex justify-between items-center text-[10px] mt-1 text-slate-400 font-semibold">
                            <span class="text-pink-400">${card.rarity}</span>
                            <span class="bg-slate-800 px-1.5 py-0.5 rounded text-yellow-300">${isUnlocked ? `x${qty}` : '0'}</span>
                        </div>
                    </div>
                `;

                if (isUnlocked) {
                    slotEl.addEventListener('click', () => {
                        openInspector(card);
                    });
                }

                binderGrid.appendChild(slotEl);
            });
        }

        btnOpenBinder.addEventListener('click', () => {
            renderBinder();
            binderModal.classList.remove('hidden');
        });

        btnCloseBinder.addEventListener('click', () => {
            binderModal.classList.add('hidden');
        });

        function openInspector(card) {
            document.getElementById('inspector-card-name').innerText = card.name;
            document.getElementById('inspector-card-rarity').innerText = `${card.rarity} Card`;

            inspectorCardTarget.innerHTML = createCardHTML(card, true, 0);
            const cardEl = inspectorCardTarget.querySelector('.tcg-card-item');
            cardEl.classList.add('is-flipped');
            cardEl.style.transform = 'rotateY(180deg)';

            attachHoloTiltListeners(cardEl);

            inspectorModal.classList.remove('hidden');
        }

        btnCloseInspector.addEventListener('click', () => {
            inspectorModal.classList.add('hidden');
        });


        /* ==========================================================================
           10. ODDS & AUDIO TOGGLES
           ========================================================================== */
        const oddsModal = document.getElementById('odds-modal');
        document.getElementById('btn-show-odds').addEventListener('click', () => oddsModal.classList.remove('hidden'));
        document.getElementById('btn-close-odds').addEventListener('click', () => oddsModal.classList.add('hidden'));

        const audioBtn = document.getElementById('btn-audio-toggle');
        const audioIcon = document.getElementById('audio-icon');

        audioBtn.addEventListener('click', () => {
            soundFX.enabled = !soundFX.enabled;
            if (soundFX.enabled) {
                audioIcon.className = 'fa-solid fa-volume-high text-sm text-pink-400';
            } else {
                audioIcon.className = 'fa-solid fa-volume-xmark text-sm text-slate-500';
            }
        });

        // Initialize state on page load
        loadState();
    </script>
</body>
</html>
