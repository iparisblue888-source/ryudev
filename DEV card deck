        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        tcgDark: '#080911',
                        tcgCardBg: '#151828',
                        tcgGold: '#fbbf24',
                        tcgPink: '#f472b6',
                        tcgPurple: '#a855f7'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
